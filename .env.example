# ============================================================
# SYSTEM CODE — Variaveis de Ambiente
# Copie este arquivo para .env e preencha com seus valores reais
# NUNCA versione o .env no GitHub
# ============================================================

# --- GITHUB ---
GITHUB_USER=seu_usuario
GITHUB_TOKEN=ghp_xxxxxxxxxxxxxxxxxxxx
GITHUB_REPO=https://github.com/seu_usuario/sytem_code.git

# --- N8N ---
N8N_BASE_URL=http://localhost:5678
N8N_API_KEY=sua_api_key_n8n
N8N_WEBHOOK_URL=http://localhost:5678/webhook/system-code

# --- WHATSAPP / EVOLUTION API ---
EVOLUTION_API_URL=http://localhost:8080
EVOLUTION_API_KEY=sua_api_key_evolution
EVOLUTION_INSTANCE=nome_da_instancia

# --- TELEGRAM ---
TELEGRAM_BOT_TOKEN=seu_bot_token
TELEGRAM_CHAT_ID=seu_chat_id

# --- SERVIDOR ---
VPS_IP=seu_ip_da_vps
VPS_USER=claude
WEBHOOK_PORT=9000

# --- LOGS ---
LOG_DIR=/home/claude/system_code/logs
LOG_MAX_SIZE_MB=10
LOG_RETENTION_DAYS=30

# --- ALERTAS ---
ALERT_EMAIL=seu@email.com
ALERT_WEBHOOK_URL=
